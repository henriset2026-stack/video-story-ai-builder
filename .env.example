# Copy to .env.local and fill in. Never commit real values.

# --- AI provider -------------------------------------------------------------
# anthropic | openai | gemini
AI_PROVIDER=anthropic
# Server-only. Leave empty to run in mock mode with deterministic sample storyboards.
AI_PROVIDER_API_KEY=
# Optional model override. Defaults: anthropic=claude-sonnet-5, openai=gpt-5-mini, gemini=gemini-2.5-flash
AI_MODEL=
# Optional OpenAI-compatible endpoint (an AI router), used when AI_PROVIDER=openai.
# Example: AI_BASE_URL=https://router.bynara.id/v1 with AI_MODEL=agnes-2.5-flash
AI_BASE_URL=
# Force mock mode even when a key is set (useful for UI work and tests).
AI_MOCK_MODE=false
# Per-call timeout for AI requests, in milliseconds.
AI_TIMEOUT_MS=120000
# Artificial delay per mock step so progress is visible in the UI (0 disables).
AI_MOCK_LATENCY_MS=250

# --- Firebase (Cloud Firestore) ----------------------------------------------
# From a service-account key: Firebase console > Project settings > Service accounts > Generate new private key.
# All three are server-only. Never expose them to the browser or commit them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line with literal \n for line breaks, in double quotes.
FIREBASE_PRIVATE_KEY=

# --- Storage -----------------------------------------------------------------
# firestore | local. Defaults to firestore when the three Firebase values are set, otherwise local.
STORAGE_DRIVER=
# Directory for the local development store.
LOCAL_DATA_DIR=.data
