rules_version = '2';

// Video Story AI Builder — all data access goes through the Next.js server, which uses the
// Firebase Admin SDK (service account). Admin access bypasses these rules, so browsers and
// mobile clients get no direct access at all. When user accounts are added, open
// projects/{projectId} to request.auth.uid == resource.data.ownerId.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
